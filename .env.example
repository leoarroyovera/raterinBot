# Credenciales de app de https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# Token de un bot NUEVO creado con @BotFather
TG_BOT_TOKEN=
# Tu user_id numerico (@userinfobot). Solo vos podes usar el bot.
