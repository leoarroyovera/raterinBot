# Credenciales de app de https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# Token de un bot NUEVO creado con @BotFather
TG_BOT_TOKEN=
# Tu user_id numerico (@userinfobot). Solo vos podes usar el bot.
TG_OWNER_ID=

# 1 = solo ofrecer grupos/canales donde sos creador o admin (default)
# 0 = ofrecer todos los grupos donde podes escribir
SOLO_GRUPOS_PROPIOS=1

# Modo por defecto al mandar varios archivos juntos (se puede cambiar con /modo):
# separado = un mensaje por archivo; zip = un ZIP con todo + album de imagenes
MODO_GRUPO=separado
# Limite de subida en MiB. Vacio = automatico (4000 si tu cuenta es Premium, 2000 si no)
MAX_UPLOAD_MB=
# Tamano maximo de cada ZIP en MiB. Vacio = el limite de subida
ZIP_MAX_MB=
# Espacio libre minimo a dejar en disco al descargar (MiB)
MARGEN_DISCO_MB=3000
